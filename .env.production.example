# ==============================================================================
# WMAX Production Environment Configuration
# ==============================================================================
# Security Notice:
# NEVER commit the actual .env file containing production secrets!
# Generate cryptographic keys using the commands shown below.
# ==============================================================================

ENV=production

# ---- domain / TLS (Nginx + Certbot / Caddy auto Let's Encrypt) ----
DOMAIN=wmax.example.uz
ACME_EMAIL=admin@wmax.uz

# ---- postgres ----
# Generate strong password: openssl rand -base64 32
POSTGRES_USER=wmax
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=wmax
DATABASE_URL=postgresql+asyncpg://wmax:generate_strong_password_here@postgres:5432/wmax

# ---- security (majburiy) ----
# Minimum 32 bytes secret. Generate: openssl rand -base64 48
JWT_SECRET=generate_strong_jwt_secret_48_bytes_base64_here
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Demo hisoblar PRODUKSIYADA HAR DOIM false bo'lishi shart!
ENABLE_DEMO_ACCOUNTS=false

# Soat hamroh ilovasi /api/v1/ingest uchun API kalit.
# Generate: openssl rand -hex 32
INGEST_API_KEY=generate_strong_ingest_key_32_hex_here

# Ruxsat etilgan domenlar (CORS). Bo'sh qoldirilsa faqat same-origin ruxsat etiladi.
CORS_ORIGINS=https://wmax.example.uz

# ---- rate limiting ----
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SEC=300

# ---- qarovchi havolasi (kun) ----
RELATIVE_TOKEN_TTL_DAYS=90

# ---- background workers ----
ENABLE_WORKERS=true
WORKER_LOCK_ID=874113001

# ---- telegram bot ----
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=https://wmax.example.uz

# ---- clinical config ----
TZ_LOCAL=Asia/Tashkent
NO_DATA_MINUTES=45
CONSECUTIVE_WINDOWS=3
ALERT_COOLDOWN_HOURS=6

# ---- ai assistant (Gemini Flash) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- ai provider ----
# Qaysi LLM ishlatiladi: deepseek | gemini
AI_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com). OpenAI-mos API.
DEEPSEEK_API_KEY=
# deepseek-chat (V3, tez va arzon) | deepseek-reasoner (R1, chuqurroq tahlil)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
