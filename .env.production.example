# ==============================================================================
# NAZORAT Enterprise Production Environment Configuration
# Copy to .env and populate with cryptographically secure values.
# NEVER commit real .env or secrets to version control!
# ==============================================================================

# ---- Environment Mode ----
ENV=production
TZ_LOCAL=Asia/Tashkent

# ---- Domain & TLS (Cloudflare DNS-only, Let's Encrypt automated) ----
DOMAIN=nazorat.example.uz
ACME_EMAIL=admin@example.uz

# ---- PostgreSQL Database ----
POSTGRES_USER=nazorat
POSTGRES_PASSWORD=generate_a_secure_32_char_password_here
POSTGRES_DB=nazorat
DATABASE_URL=postgresql+asyncpg://nazorat:generate_a_secure_32_char_password_here@postgres:5432/nazorat
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- Redis In-Memory Cache & Sessions ----
REDIS_URL=redis://redis:6379/0

# ---- Google Gemini AI Integration ----
GEMINI_API_KEY=AIzaSy_generate_your_production_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- Authentication & Security (A6) ----
JWT_SECRET=generate_minimum_32_bytes_random_secret_string_here
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30

# ---- Notifier & Telegram Bot (A6) ----
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
PUBLIC_BASE_URL=https://nazorat.example.uz

# ---- Observability & Monitoring ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_enterprise_grafana_password_2026

# ---- Restic Backup (Optional Cloud S3 / B2) ----
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/nazorat-backups
# RESTIC_PASSWORD=restic_encryption_passphrase
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Clinical Telemonitoring Domain Config ----
NO_DATA_MINUTES=45
CONSECUTIVE_WINDOWS=3
ALERT_COOLDOWN_HOURS=6
