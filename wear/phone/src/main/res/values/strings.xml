    <!-- Onboarding & Promo -->
    <string name="onboarding_badge">AQLLI BEMOR MONITORINGI</string>
    <string name="onboarding_title">Sog\'lig\'ingiz har soniya shifokor nazoratida</string>
    <string name="onboarding_desc">WMAX sun\'iy intellekti va shifokorlar guruhi sizning holatingizni masofadan uzluksiz kuzatib boradi.</string>
    <string name="features_section_title">Aqlli soat nima qila oladi?</string>

    <string name="watch_cap_universal_title">Ixtiyoriy Wear OS soatiga mos</string>
    <string name="watch_cap_universal_desc">Alohida qimmat apparat sotib olish shart emas. O\'zingizdagi ixtiyoriy Samsung Galaxy Watch, Pixel Watch yoki boshqa Wear OS soatiga ulanadi.</string>

    <string name="watch_cap_hr_title">24/7 Doimiy Puls va Aritmiya</string>
    <string name="watch_cap_hr_desc">Yurak urish tezligini har daqiqa o\'lchaydi. Taxikardiya, bradikardiya va xavfli ritm buzilishlarini zudlik bilan aniqlaydi.</string>

    <string name="watch_cap_spo2_title">SpO2 — Qondagi kislorod miqdori</string>
    <string name="watch_cap_spo2_desc">Gipoksiya va nafas qisilishini uyquda ham, kunduzgi faollikda ham uzluksiz nazorat qiladi.</string>

    <string name="watch_cap_hrv_title">HRV va Stress / Charchoq indeksi</string>
    <string name="watch_cap_hrv_desc">Yurak ritmi variatsiyasi (RMSSD) orqali yurak-qon tomir va asab tizimi zo\'riqishini baholaydi.</string>

    <string name="watch_cap_temp_title">Tana harorati va Nafas chastotasi</string>
    <string name="watch_cap_temp_desc">Yashirin shamollash, infeksiya yoki nafas dekompensatsiyasining dastlabki alomatlarini erta bosqichda sezadi.</string>

    <string name="watch_cap_ai_title">AI Erta Ogohlantirish (DekomMode)</string>
    <string name="watch_cap_ai_desc">Kasallik xuruji yoki infarkt xavfini asoratlar boshlanishidan 12–24 soat oldin aniqlab, asoratlarning oldini oladi.</string>

    <string name="watch_cap_sos_title">Bir bosishda SOS chaqiruv</string>
    <string name="watch_cap_sos_desc">Holat to\'satdan yomonlashganda soatdagi SOS tugmasi orqali shifokor va oila a\'zolaringizga zudlik bilan signal yuboradi.</string>

    <string name="watch_cap_offline_title">Oflayn rejim (Internetsiz ham ishlaydi)</string>
    <string name="watch_cap_offline_desc">Internet uzilib qolsa ham o\'lchovlar soat va telefonda saqlanadi, aloqa tiklanganda avtomatik serverga yetkaziladi.</string>

