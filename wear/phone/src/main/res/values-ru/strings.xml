    <!-- Onboarding & Promo -->
    <string name="onboarding_badge">УМНЫЙ МОНИТОРИНГ ПАЦИЕНТОВ</string>
    <string name="onboarding_title">Ваше здоровье каждую секунду под контролем врача</string>
    <string name="onboarding_desc">Искусственный интеллект WMAX и команда врачей непрерывно отслеживают ваше состояние дистанционно.</string>
    <string name="features_section_title">Что умеют умные часы?</string>

    <string name="watch_cap_universal_title">Подходит к любым часам Wear OS</string>
    <string name="watch_cap_universal_desc">Не нужно покупать специальный дорогой прибор. Работает с вашими Samsung Galaxy Watch, Pixel Watch или другими часами Wear OS.</string>

    <string name="watch_cap_hr_title">24/7 Пульс и контроль аритмии</string>
    <string name="watch_cap_hr_desc">Измеряет пульс каждую минуту. Мгновенно фиксирует тахикардию, брадикардию и опасные сбои ритма.</string>

    <string name="watch_cap_spo2_title">SpO2 — Кислород в крови</string>
    <string name="watch_cap_spo2_desc">Контролирует гипоксию и проблемы с дыханием как во время сна, так и при повседневной активности.</string>

    <string name="watch_cap_hrv_title">HRV и Индекс стресса / Усталости</string>
    <string name="watch_cap_hrv_desc">Оценивает перегрузку сердца и нервной системы по вариабельности сердечного ритма (RMSSD).</string>

    <string name="watch_cap_temp_title">Температура и Частота дыхания</string>
    <string name="watch_cap_temp_desc">Распознаёт ранние признаки простуды, инфекции или легочной декомпенсации на начальном этапе.</string>

    <string name="watch_cap_ai_title">AI Раннее предупреждение (DekomMode)</string>
    <string name="watch_cap_ai_desc">Выявляет скрытые изменения за 12–24 часа до приступа и помогает предотвратить осложнения.</string>

    <string name="watch_cap_sos_title">Экстренный вызов SOS в одно касание</string>
    <string name="watch_cap_sos_desc">При резком ухудшении состояния кнопка SOS на часах немедленно отправит сигнал тревоги врачу и близким.</string>

    <string name="watch_cap_offline_title">Работает даже без интернета (Офлайн)</string>
    <string name="watch_cap_offline_desc">Даже при обрыве связи данные сохраняются на часах и телефоне, а затем автоматически передаются при появлении сети.</string>

    <string name="login_section_title">Вход в аккаунт</string>
    <string name="login_section_subtitle">Войдите с помощью номера телефона и PIN-кода, выданных врачом</string>
