# ---- domain / TLS (Cloudflare DNS-only, Caddy auto Let's Encrypt) ----
DOMAIN=wmax.example.uz
ACME_EMAIL=b20060311@gmail.com

# ---- postgres ----
POSTGRES_USER=wmax
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=wmax
DATABASE_URL=postgresql+asyncpg://wmax:change_me_in_prod@postgres:5432/wmax

# ---- security (majburiy) ----
# 32+ belgi. Generatsiya: openssl rand -base64 48
JWT_SECRET=change_me_32_bytes_minimum_secret_key_wmax
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30

# Demo hisoblar (+998901234567 / wmax123). PRODUKSIYADA HAR DOIM false.
ENABLE_DEMO_ACCOUNTS=true

# Soat hamroh ilovasi /api/v1/ingest ga shu kalit bilan murojaat qiladi.
# Generatsiya: openssl rand -hex 32
INGEST_API_KEY=dev_ingest_secret_key_wmax

# Vergul bilan ajratilgan. Caddy / Nginx ortida bo'sh qoldirish mumkin (same-origin).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- rate limiting ----
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SEC=300

# ---- qarovchi havolasi ----
RELATIVE_TOKEN_TTL_DAYS=90

# ---- background workers ----
ENABLE_WORKERS=true
WORKER_LOCK_ID=874113001

# ---- telegram (A6) ----
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=https://wmax.example.uz

# ---- clinical config (A2 / A1) ----
TZ_LOCAL=Asia/Tashkent
NO_DATA_MINUTES=45
CONSECUTIVE_WINDOWS=3
ALERT_COOLDOWN_HOURS=6

# ---- ai assistant (Gemini Flash) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- ai provider ----
# Qaysi LLM ishlatiladi: deepseek | gemini
AI_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com). OpenAI-mos API.
DEEPSEEK_API_KEY=
# deepseek-chat (V3, tez va arzon) | deepseek-reasoner (R1, chuqurroq tahlil)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
